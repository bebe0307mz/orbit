{
  "name": "orbit",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @orbit/dashboard dev",
    "api": "pnpm --filter @orbit/api start",
    "test": "pnpm -r --if-present test",
    "check:ui": "node harness/ui/check-ui.mjs && node harness/ui/check-live.mjs",
    "check:ui:mock": "node harness/ui/check-ui.mjs",
    "check:ui:live": "node harness/ui/check-live.mjs",
    "check:contrast": "node harness/ui/contrast.mjs",
    "harness": "node harness/run.mjs",
    "demo:attack": "node --experimental-strip-types --no-warnings=ExperimentalWarning demo/attack/src/main.ts",
    "orbit-cli": "node --experimental-strip-types --no-warnings=ExperimentalWarning tools/orbit-cli/src/main.ts",
    "merchant": "pnpm --filter @orbit/merchant start",
    "demo:agents": "pnpm --silent --filter @orbit/demo-agents start",
    "demo:setup": "node --experimental-strip-types --no-warnings=ExperimentalWarning demo/agents/src/setup.ts"
  }
}
