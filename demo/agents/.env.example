# demo/agents config (testnet). Keys live outside the repo in DEMO_KEY_DIR.
NEAR_NETWORK=testnet
VAULT_ACCOUNT_ID=orbit-vault-fkuc.testnet
NEAR_RPC_URL=https://rpc.testnet.near.org,https://test.rpc.fastnear.com
MERCHANT_URL=http://127.0.0.1:8402
MERCHANT_ACCOUNT_ID=orbit-merchant-fkuc.testnet
TOKEN_ACCOUNT_ID=orbit-token-fkuc.testnet
# services/api for tx reports (optional)
ORBIT_API_URL=http://127.0.0.1:8787
# default: ~/.near-credentials/orbit-testnet/<vault>
DEMO_KEY_DIR=
DEMO_LOG=
# --register uses tools/orbit-cli with the owner key: OWNER_ACCOUNT_ID, ORBIT_OWNER_KEY_FILE (default ~/.near-credentials/testnet/<owner>.json)
OWNER_ACCOUNT_ID=orbit-owner-fkuc.testnet
