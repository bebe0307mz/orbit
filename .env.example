# Copy to .env (never committed). All config is env-driven.
NEAR_NETWORK=testnet
# Comma list, first is primary. rpc.*.near.org is deprecated (JSON-RPC -429); keep it last if at all.
NEAR_RPC_URL=https://test.rpc.fastnear.com,https://rpc.testnet.fastnear.com,https://rpc.testnet.near.org
VAULT_ACCOUNT_ID=
TOKEN_ACCOUNT_ID=
OWNER_ACCOUNT_ID=
# API (services/api)
GUARDIAN_KEY_FILE=
OPERATOR_PASSWORD_HASH=
SESSION_SECRET=
