{
  "name": "@orbit/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Orbit agent SDK: key generation, vault pay() with unknown-outcome handling, orbitFetch() HTTP 402 client",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "orbit-agent": "./src/cli.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:testnet": "ORBIT_TESTNET=1 vitest run test/testnet.test.ts",
    "typecheck": "tsc --noEmit",
    "keygen": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/cli.ts keygen"
  },
  "dependencies": {
    "@near-js/crypto": "2.5.1",
    "@near-js/transactions": "2.5.1",
    "@near-js/utils": "2.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
