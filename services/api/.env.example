# services/api configuration (docs 4-data-api.md 4.8). Copy to .env on the API VM; never commit real values.
NEAR_NETWORK=testnet
VAULT_ACCOUNT=
# rpc.testnet.near.org / rpc.mainnet.near.org are deprecated and throttle intermittently (-429): last fallback only
RPC_URL=https://test.rpc.fastnear.com
# comma list, tried in order
RPC_FALLBACK_URL=https://rpc.testnet.fastnear.com,https://rpc.testnet.near.org
SYNC_INTERVAL_MS=3000
# faster sync while payments are moving (pending, or new outcomes in the last 20 s)
SYNC_FAST_MS=1000
STALE_MS=15000
# One SQLite file per network and vault
DB_PATH=./data/orbit-testnet.sqlite
# Guardian FC key (pause_agent,pause_all only), outside the repo, mode 600: pnpm --filter @orbit/api keygen /secure/path/guardian.json
GUARDIAN_KEY_FILE=
# printf '%s' "$PASSWORD" | pnpm --silent --filter @orbit/api hash-password
OPERATOR_PASSWORD_HASH=
# pnpm --silent --filter @orbit/api session-secret
SESSION_SECRET=
SESSION_TTL_MS=43200000
# Exact origin the dashboard is served from (writes must carry this Origin)
PUBLIC_ORIGIN=http://localhost:8787
# Secure cookies are on unless PUBLIC_ORIGIN is http://localhost or 127.0.0.1; override with COOKIE_SECURE=true|false
COOKIE_SECURE=
OP_UNRESOLVED_MS=600000
OP_POLL_MS=3000
TX_REPORTS_ENABLED=true
HOST=127.0.0.1
PORT=8787
# Built dashboard to serve (default ../../apps/dashboard/dist); empty disables static serving
DASHBOARD_DIR=
