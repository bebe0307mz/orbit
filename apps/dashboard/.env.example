# Dashboard config (Vite). Copy to .env.local; never commit real values.
# mock = seeded prototype data with simulated chain steps; rpc = read the vault's state()/outcomes() over NEAR JSON-RPC
VITE_SOURCE=mock
VITE_NETWORK=testnet
VITE_NEAR_RPC_URL=https://rpc.testnet.near.org
VITE_VAULT_ACCOUNT_ID=
# Org label in the header (plain text)
VITE_ORG_NAME=orbit-team
# State poll interval in ms (spec: 3000, fallback 10000)
VITE_POLL_MS=3000
